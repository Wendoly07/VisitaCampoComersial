# ===== Servidor =====
PORT=4000
# Zona horaria del país (las fechas se guardan en hora local)
TZ_PAIS=America/Tegucigalpa
# Orígenes permitidos para CORS (URL del frontend). Separar con coma.
CORS_ORIGINS=http://localhost:5173

# ===== Azure SQL =====
# Opción 1: cadena de conexión completa
# DB_CONNECTION_STRING=Server=tcp:miservidor.database.windows.net,1433;Database=visitapro;User Id=usuario;Password=clave;Encrypt=true;
# Opción 2: valores separados
DB_SERVER=miservidor.database.windows.net
DB_NAME=visitapro
DB_USER=usuario
DB_PASSWORD=clave
# Esquema de las tablas (dbo en desarrollo; puede ser otro en producción)
DB_SCHEMA=dbo

# ===== Autenticación =====
JWT_SECRET=cambie-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES=12h

# ===== Inicio de sesión con Microsoft (opcional) =====
# Registro de aplicación en Microsoft Entra ID (tipo SPA)
MS_TENANT_ID=
MS_CLIENT_ID=
# Crear automáticamente el usuario si inicia con Microsoft y no existe
MS_AUTO_CREAR_USUARIO=false

# ===== Azure Blob Storage (fotos y firmas) =====
# Si se deja vacío, los archivos se guardan en la carpeta local ./uploads (solo para desarrollo)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=visitapro
# Minutos de validez de los enlaces de lectura (SAS)
BLOB_SAS_MINUTOS=120
